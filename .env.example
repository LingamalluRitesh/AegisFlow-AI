# AegisFlow AI Environment Configuration Template
# Copy this file to .env and customize for local or staging environments.

# Application Configuration
APP_NAME=AegisFlow-AI
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Networking & Ingress
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database Configuration (PostgreSQL / TimescaleDB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegisflow_db
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=your_secure_db_password_here

# Vortex Online Feature Store (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Vortex Offline Data Lake
DATA_LAKE_PATH=./data/lake

# Stream Processing (Kafka / Redpanda)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTIONS_TOPIC=financial-transactions-v1
KAFKA_FRAUD_ALERTS_TOPIC=fraud-alerts-v1
KAFKA_INTERACTIONS_TOPIC=user-interactions-v1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/telemetry
